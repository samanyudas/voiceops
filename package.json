{
  "name": "voiceops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Synthetic voice-to-work-order proof of concept with deterministic policy and durable Postgres dispatch",
  "engines": {
    "node": ">=24.21.0 <27",
    "npm": ">=12.2.0 <13"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build && node --test tests/*.test.mjs",
    "selftest": "node dist/tools/repository-policy.js --selftest",
    "check:repo": "node dist/tools/repository-policy.js",
    "eval": "npm run build && node --test tests/repository-policy.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run selftest && npm run check:repo",
    "package:source": "node tools/package-source.mjs",
    "check:package": "node tools/check-package.mjs",
    "start": "node --env-file-if-exists=.env dist/tools/server.js",
    "seed": "node --env-file-if-exists=.env dist/tools/seed.js",
    "technician": "node --env-file-if-exists=.env dist/tools/technician.js",
    "test:integration": "npm run build && node --test --test-timeout=30000 tests/integration/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "effect": "4.0.0"
  }
}
